{
  "language": "japanese",
  "autoMemoryEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "nix fmt 2>/dev/null || true; echo '{\"systemMessage\":\"nix fmt hook fired\"}'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(nix build)",
      "Bash(nix fmt)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(ls)"
    ]
  }
}
